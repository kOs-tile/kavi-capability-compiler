{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kavi-ai.com/schemas/kcc.capabilities.v1.schema.json",
  "title": "KCC Universal Capability Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "capabilities",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "const": "kcc.capabilities.v1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "namespace",
          "name",
          "description",
          "input_schema",
          "annotations",
          "fingerprint",
          "source"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "input_schema": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

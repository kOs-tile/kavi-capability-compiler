{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kavi-ai.com/schemas/kcc.inventory.v1.schema.json",
  "title": "KCC Capability Inventory",
  "type": "object",
  "required": ["version", "capabilities", "digest"],
  "properties": {
    "version": {"const": "kcc.inventory.v1"},
    "adapter": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "provider", "server", "name", "description", "input_schema",
          "fingerprint", "effect", "confidence", "analysis", "annotations"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "server": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "input_schema": {"type": "object"},
          "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "effect": {
            "enum": ["read", "write", "delete", "execute", "financial", "deploy", "external_message", "unknown"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "analysis": {"type": "object"},
          "annotations": {"type": "object"},
          "source": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

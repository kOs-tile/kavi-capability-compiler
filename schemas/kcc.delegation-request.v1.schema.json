{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kavi-ai.com/schemas/kcc.delegation-request.v1.schema.json",
  "title": "KCC Delegation Request",
  "type": "object",
  "required": ["version", "parent_capsule_id", "capabilities"],
  "properties": {
    "version": {"const": "kcc.delegation-request.v1"},
    "parent_capsule_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {"type": ["string", "null"]},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "constraints": {
            "type": "object",
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "parameters": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
